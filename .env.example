# ── 默认连接 ──────────────────────────────────
# 下面的值会被任何预设模型继承（除非被下面的 LLM_<NAME>_* 覆盖）
LLM_BASE_URL=https://api.ibax.cn/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# ── 各 Provider 的 API Key（默认被预设使用） ──
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# QWEN_API_KEY=sk-xxx

# ── 覆盖单个模型的 baseURL 和 apiKey ──────────
# 格式: LLM_<模型名大写>_BASE_URL / LLM_<模型名大写>_API_KEY
# 模型名中的 - 替换为 _
#
# 例: 用本地 Ollama 跑 deepseek-chat
# LLM_DEEPSEEK_CHAT_BASE_URL=http://localhost:11434/v1
# LLM_DEEPSEEK_CHAT_API_KEY=ollama
#
# 例: 给 gpt-4o 走代理
# LLM_GPT4O_BASE_URL=https://my-proxy.com/v1
# LLM_GPT4O_API_KEY=sk-proxy-key
#
# 例: 自定义模型连本地服务
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3